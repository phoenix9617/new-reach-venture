---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Building the Future of Autonomous Media & Software">
  <!-- Hero Section -->
  <section class="relative pt-28 pb-24 px-6 border-b border-neutral-800/60 overflow-hidden">
    <!-- Subtle Grid Background -->
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#1f29370f_1px,transparent_1px),linear-gradient(to_bottom,#1f29370f_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-indigo-500/15 via-cyan-500/5 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto text-center space-y-7">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-950/40 text-indigo-300 text-xs font-medium backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Venture Studio & Holding Engine
      </div>
      
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.1]">
        Engineering high-impact <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-300 to-cyan-400">
          digital ventures & software.
        </span>
      </h1>
      
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-400 font-normal leading-relaxed">
        New Reach Venture is an agile studio incubator. We design, launch, and scale independent software tools, media systems, and interactive digital products with lean operational overhead.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a href="/portfolio" class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transition-all">
          Explore Portfolio
        </a>
        <a href="/about" class="px-6 py-3.5 rounded-xl border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 text-neutral-300 font-medium text-sm transition-all hover:border-neutral-700">
          About the Studio
        </a>
      </div>
    </div>

    <!-- Quick Stats Bar -->
    <div class="max-w-4xl mx-auto mt-20 pt-10 border-t border-neutral-800/60 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl font-extrabold text-white">6+</p>
        <p class="text-xs text-neutral-500 mt-1 uppercase tracking-wider font-medium">Active Ventures</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-white">100%</p>
        <p class="text-xs text-neutral-500 mt-1 uppercase tracking-wider font-medium">Independent</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-white">Multi-OS</p>
        <p class="text-xs text-neutral-500 mt-1 uppercase tracking-wider font-medium">Web, iOS & Android</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-white">Automated</p>
        <p class="text-xs text-neutral-500 mt-1 uppercase tracking-wider font-medium">Unit Architecture</p>
      </div>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="py-24 px-6 max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="text-xs uppercase tracking-widest text-indigo-400 font-semibold">Core Focus</span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">How We Build & Scale</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-8 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-indigo-500/40 hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-105 transition-transform">
          01
        </div>
        <h3 class="text-xl font-bold text-white mb-3">SaaS & Utilities</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          High-utility SaaS applications and merchant automation tools engineered to solve targeted bottlenecks with lean operational overhead.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-cyan-500/40 hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-105 transition-transform">
          02
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Digital Media & Publishing</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Autonomous content delivery engines, real-time news aggregation, and modern audience-facing digital publications powered by AI intelligence.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-105 transition-transform">
          03
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Interactive Gaming</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Physics-based HTML5 web and mobile arcade games designed with addictive mechanics, published across global web portals and app stores.
        </p>
      </div>
    </div>
  </section>
</Layout>