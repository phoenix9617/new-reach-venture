---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About New Reach Venture">
  <section class="py-24 px-6 max-w-4xl mx-auto space-y-16">
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-500/20 bg-indigo-500/10 text-indigo-400 text-xs font-semibold uppercase tracking-wider">
        Our Mission
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Independent software. <br />
        Engineered for autonomy.
      </h1>
      <p class="text-lg text-neutral-300 font-light leading-relaxed">
        New Reach Venture is an agile studio incubator designed to research, build, and deploy high-utility digital assets across diverse software ecosystems.
      </p>
    </div>

    <!-- Core Philosophy Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 not-prose">
      <div class="p-7 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700 transition-all">
        <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold mb-4">
          ⚡
        </div>
        <h3 class="text-white font-bold text-lg mb-2">Agile Deployment</h3>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Rapid prototyping to test ideas directly against live consumer and commercial demand.
        </p>
      </div>
      <div class="p-7 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700 transition-all">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold mb-4">
          📈
        </div>
        <h3 class="text-white font-bold text-lg mb-2">Capital Independence</h3>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Zero bloat, sustainable unit economics, and compounded value through automated software revenue.
        </p>
      </div>
    </div>

    <!-- What We Build Section -->
    <div class="space-y-6 pt-6 border-t border-neutral-800/80">
      <h2 class="text-2xl font-bold text-white tracking-tight">Focus Domains</h2>
      <div class="space-y-4">
        <div class="p-5 rounded-xl bg-neutral-900/20 border border-neutral-800/60 flex items-start gap-4">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 mt-2 shrink-0"></span>
          <div>
            <h4 class="text-white font-semibold text-base mb-1">Autonomous Utilities & SaaS</h4>
            <p class="text-sm text-neutral-400">Targeted tools built for e-commerce platforms, catalog management, and automated merchant analytics.</p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-neutral-900/20 border border-neutral-800/60 flex items-start gap-4">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 mt-2 shrink-0"></span>
          <div>
            <h4 class="text-white font-semibold text-base mb-1">Media & Intelligence Engines</h4>
            <p class="text-sm text-neutral-400">High-signal news aggregation feeds, algorithmic discussion platforms, and AI-assisted content distribution.</p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-neutral-900/20 border border-neutral-800/60 flex items-start gap-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mt-2 shrink-0"></span>
          <div>
            <h4 class="text-white font-semibold text-base mb-1">Casual & Arcade Gaming</h4>
            <p class="text-sm text-neutral-400">Lightweight, physics-centric games engineered for frictionless distribution across web portals and mobile stores.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>